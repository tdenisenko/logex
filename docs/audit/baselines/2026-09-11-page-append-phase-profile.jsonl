ct_nullable_b256_values','write_pages','write_fixed_col','write_var_col']:label='format!(\"'+name+':{name}\")'\n  if name=='write_nullable_col':label='format!(\"'+name+':{base_name}\")'\n  s=s[:b]+'\\n        #[cfg(test)] let _profile = '+prefix+'ProfileScope::new('+label+');'+s[b:]\n p.write_text(s)\nfixture=Path('crates/logex-storage/tests/ingestion_publication.rs').read_text();fixture=fixture[fixture.index('use alloy_consensus'):fixture.index('fn anchor(')].replace('use logex_storage::{PartitionManager, PartitionManagerConfig, SegmentReader};','use super::*;')\np=Path(files[1]);s=p.read_text();s+='''\n#[cfg(test)]\nmod historical_checkpoint_profile {\n'''+fixture+'''\n    #[test]\n    #[ignore]\n    fn profile_historical_phases() {\n        for (blocks, rows_per_block) in [(128,1),(128,128),(512,1024)] {\n            let config = Config { blocks, warm_headers: 8192, rows_per_block, history_batch_blocks: 2048, segment_rows: 1000000, repeats: 3, route: Some(true), checkpoint_each_block: false, rich_headers: false };\n            let (headers, blocks) = fixture(&config);\n            let rows:Vec<_> = blocks.into_iter().flatten().collect();\n            for iteration in 0..3 {\n                let dir = tempfile::tempdir().unwrap();\n                let mut storage = NativeStorage::open(NativeStorageConfig { data_dir: dir.path().to_owned(), ..Default::default() }).unwrap();\n                storage.record_historical_floor(headers.last().unwrap()).unwrap();\n                durability::profile_take();\n                let start = std::time::Instant::now();\n                storage.ingest_historical_batch(&rows, &headers[config.warm_headers]).unwrap();\n                storage.finalize_active_historical_segment().unwrap();\n                storage.checkpoint().unwrap();\n                println!(\"{}\", json!({\"kind\":\"historical_profile\",\"iteration\":iteration,\"rows\":rows.len(),\"elapsed_ms\":start.elapsed().as_secs_f64()*1000.0,\"phases\":durability::profile_take()}));\n                let mut actual:Vec<_> = storage.segments().iter().filter(|s|s.row_count>0).flat_map(|s|SegmentReader::open(&storage.segment_path(s.id)).unwrap().read_log_rows(None).unwrap()).collect();\n                actual.sort_by_key(|r|(r.block_number,r.log_index));\n                assert_eq!(actual,rows);\n            }\n        }\n    }\n}\n''';p.write_text(s)\n", "binary_sha256": "cdc4c5adefca9cb3666c8ce7acaf1a016d4771b64f28a079727e6ca0165dd338", "note": "Instrumented release phase timings are diagnostic, not acceptance benchmarks. Nested/parallel durations overlap and must not be added. Same local APFS host as original comparison; fixture includes finalization/checkpoint and exact-row oracle. Instrumentation was removed after building a copied test binary."}
