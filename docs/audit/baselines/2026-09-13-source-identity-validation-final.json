    "runner_source": "\"\"\"Run exact-source workspace/release gates sequentially and retain all outcomes.\"\"\"\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nimport hashlib,json,os,subprocess,sys\nREPO=Path('/Users/tdenisenko/code/logex')\nROOT=Path(sys.argv[1]); ROOT.mkdir(exist_ok=False)\npaths=['crates','vendor','tools','scripts','.github','.cargo','Cargo.toml','Cargo.lock','rust-toolchain.toml']\ndef output(command):return subprocess.check_output(command,cwd=REPO,text=True).strip()\ndef digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()\ndef stable():\n assert not subprocess.check_output(['git','diff','HEAD','--',*paths],cwd=REPO)\n unexpected=[n for n in subprocess.check_output(['git','ls-files','--others','--exclude-standard','--',*paths],cwd=REPO,text=True).splitlines() if Path(n).name!='.DS_Store']\n assert not unexpected,unexpected\nstable()\nnames=subprocess.check_output(['git','ls-files','-z','--',*paths],cwd=REPO).decode().split('\\0')\nsource={name:digest(REPO/name) for name in names if name}\nrecord={'schema':1,'head':output(['git','rev-parse','HEAD']),'branch':output(['git','branch','--show-current']),'source_files':source,'toolchain':output(['rustc','-Vv']),'cargo':output(['cargo','-V']),'platform':output(['uname','-a']),'started_at_utc':datetime.now(timezone.utc).isoformat(),'runner_source':Path(__file__).read_text(),'checks':[]}\ncommands=[\n ('vendor',['python3','tools/verify_datafusion_vendor.py']),\n ('fmt',['cargo','fmt','--all','--','--check']),\n ('check',['cargo','check','--workspace','--all-targets','--locked']),\n ('clippy',['cargo','clippy','--workspace','--all-targets','--locked','--','-D','warnings']),\n ('test',['cargo','test','--workspace','--all-targets','--locked']),\n ('doc',['cargo','test','--workspace','--doc','--locked']),\n ('release',['cargo','build','-p','logex-node','--release','--locked']),\n ('release-query',['cargo','test','-p','logex-query','--release','--locked']),\n ('release-consistency',['cargo','test','-p','logex-server','--release','--locked','--test','consistency']),\n]\nfor name,command in commands:\n stable();assert output(['git','rev-parse','HEAD'])==record['head']\n assert {n:digest(REPO/n) for n in source}==source\n log=ROOT/(name+'.log');started=datetime.now(timezone.utc).isoformat()\n with log.open('w') as stream:\n  run=subprocess.run(command,cwd=REPO,stdout=stream,stderr=subprocess.STDOUT,env=os.environ|{'TMPDIR':'/private/tmp'})\n record['checks'].append({'name':name,'command':command,'exit':run.returncode,'started_at_utc':started,'finished_at_utc':datetime.now(timezone.utc).isoformat(),'log':str(log),'log_sha256':digest(log)})\n (ROOT/'results.json').write_text(json.dumps(record,indent=2)+'\\n')\n print(name,'exit',run.returncode,flush=True)\n if run.returncode:sys.exit(run.returncode)\nstable();assert {n:digest(REPO/n) for n in source}==source\nrecord['completed_at_utc']=datetime.now(timezone.utc).isoformat()\n(ROOT/'results.json').write_text(json.dumps(record,indent=2)+'\\n')\nprint('All nine checks passed',flush=True)\n",
