{"kind": "warning", "message": "BENCHMARK-ONLY DIAGNOSTIC, NOT CRASH SAFE. Tests temporarily defer mutable canonical/manifest publication to estimate the possible benefit of immutable canonical metadata. Source restored before running. No node binary or production dataset used. Not implementation acceptance.", "build_script": "from pathlib import Path\nimport subprocess\nsource = Path('crates/logex-storage/src/native/storage.rs')\noriginal = source.read_bytes()\ntry:\n    text = original.decode()\n    # DIAGNOSTIC ONLY: model the barriers removable after canonical metadata\n    # becomes immutable. The present format cannot recover every crash under\n    # this rule. Compile only the isolated benchmark; never build a node binary.\n    old = 'pending.origin.can_defer(id))'\n    assert text.count(old) == 1\n    text = text.replace(old, 'pending.origin.can_defer(id) || self.catalog.segments.iter().any(|s| s.id == id && s.column_bundle.is_some()))', 1)\n    old = '.filter(|segment| pending.origin.can_defer(segment.id))'\n    assert text.count(old) == 1\n    text = text.replace(old, '.filter(|segment| pending.origin.can_defer(segment.id) || (pending.origin.includes(segment.id) && segment.column_bundle.is_some()))', 1)\n    source.write_text(text)\n    Path('/tmp/logex-immutable-canonical-diagnostic-source.diff').write_text(subprocess.check_output(['git','diff','--','crates/logex-storage'],text=True))\n    import subprocess,json,pathlib,shutil\n    for label,cwd in [('candidate','/Users/tdenisenko/code/logex')]:\n     print('Building',label,flush=True)\n     result=subprocess.run(['cargo','test','-p','logex-storage','--release','--test','ingestion_publication','--locked','--no-run','--message-format=json'],cwd=cwd,text=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)\n     pathlib.Path('/tmp/logex-immutable-canonical-diagnostic-build-'+label+'.log').write_text(result.stderr)\n     if result.returncode: raise RuntimeError(result.stderr)\n     matches=[json.loads(line)['executable'] for line in result.stdout.splitlines() if json.loads(line).get('executable') and json.loads(line).get('target',{}).get('name')=='ingestion_publication']\n     assert len(matches)==1,matches\n     shutil.copy2(matches[0],'/tmp/logex-immutable-canonical-diagnostic-'+label+'-bench')\n     print(label,'built',flush=True)\nfinally:\n    source.write_bytes(original)\n", "compare_script": "import hashlib,json,os,pathlib,subprocess,statistics\nbase=pathlib.Path('/tmp/logex-catalog-v3-base-bench')\ncandidate=pathlib.Path('/tmp/logex-immutable-canonical-diagnostic-candidate-bench')\nprofiles=[('one-row-history',1024,1,'historical',False),('many-small-history',16384,1,'historical',False)]\nwith open('/tmp/logex-immutable-canonical-diagnostic-original-comparison.jsonl','w') as output:\n output.write(json.dumps({'kind':'build','base':'09a63f555db19a03850ce5eba6f149957febaf3b','candidate':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip() + ' plus captured diff','base_binary_sha256':hashlib.sha256(base.read_bytes()).hexdigest(),'candidate_binary_sha256':hashlib.sha256(candidate.read_bytes()).hexdigest(),'harness_change':'same v3 fixture inputs/oracles with minimal and rich cached-header fields; original separate historical publication omitted fsync, candidate combines sync progress and checkpoints; per-block checkpoint option applies only to candidate; no sleeps'})+'\\n')\n for key,command in [('rustc',['rustc','-Vv']),('cargo',['cargo','-V']),('os',['sw_vers']),('kernel',['uname','-a']),('hardware',['sysctl','-n','hw.model','hw.memsize','hw.ncpu']),('filesystem_space',['df','-h','/private/tmp'])]:\n  result=subprocess.run(command,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)\n  if result.returncode:raise RuntimeError(result.stdout)\n  output.write(json.dumps({'kind':'environment','key':key,'output':result.stdout.strip()})+'\\n')\n output.write(json.dumps({'kind':'source','candidate_worktree_diff':pathlib.Path('/tmp/logex-immutable-canonical-diagnostic-source.diff').read_text(), 'diagnostic_warning':'NOT CRASH SAFE: temporary benchmark-only deferral of mutable metadata, modeling a potential immutable canonical format. Not implemented or accepted.','lockfile_sha256':hashlib.sha256(pathlib.Path('Cargo.lock').read_bytes()).hexdigest(),'fixture_sha256':hashlib.sha256(pathlib.Path('crates/logex-storage/tests/ingestion_publication.rs').read_bytes()).hexdigest(),'base_fixture_sha256':hashlib.sha256(pathlib.Path('/private/tmp/logex-publication-35p7tky4/base/crates/logex-storage/tests/ingestion_publication.rs').read_bytes()).hexdigest()})+'\\n')\n for profile,blocks,rows,route,each in profiles:\n  for pair in range(5):\n   for label in (['base','candidate'] if pair%2==0 else ['candidate','base']):\n    binary=base if label=='base' else candidate\n    log=pathlib.Path(f'/tmp/logex-immutable-canonical-diagnostic-original-{profile}-{pair}-{label}.log')\n    env=dict(os.environ,LOGEX_PUBLICATION_HEADER_FIELDS='rich' if profile.startswith('rich-') else 'minimal',LOGEX_PUBLICATION_BLOCKS=str(blocks),LOGEX_PUBLICATION_ROWS_PER_BLOCK=str(rows),LOGEX_PUBLICATION_HISTORY_BLOCKS='1' if profile=='one-row-history' else '128',LOGEX_PUBLICATION_SEGMENT_ROWS='1000000',LOGEX_PUBLICATION_WARM_HEADERS='8192',LOGEX_PUBLICATION_REPEATS='3',LOGEX_PUBLICATION_ROUTE=route,LOGEX_PUBLICATION_CHECKPOINT_EACH_BLOCK=str(int(each)))\n    with log.open('w') as capture:\n     r=subprocess.run(['/usr/bin/time','-l',str(binary),'benchmark_sync_storage_publication','--ignored','--nocapture','--test-threads=1'],env=env,stdout=capture,stderr=subprocess.STDOUT)\n    if r.returncode: raise RuntimeError(str(log)+': '+str(r.returncode))\n    for line in log.read_text().splitlines():\n     if '{' in line:\n      try: record=json.loads(line[line.index('{'):])\n      except json.JSONDecodeError: continue\n      output.write(json.dumps({**record,'profile':profile,'revision':label,'pair':pair})+'\\n')\n     elif 'maximum resident set size' in line:\n      output.write(json.dumps({'kind':'rss','profile':profile,'revision':label,'pair':pair,'bytes':int(line.split()[0])})+'\\n')\n    output.flush(); print(profile,pair,label,'passed',flush=True)\n records=[json.loads(line) for line in pathlib.Path('/tmp/logex-immutable-canonical-diagnostic-original-comparison.jsonl').read_text().splitlines()]\n for profile,*_ in profiles:\n  metrics=sorted({r['metric'] for r in records if r.get('profile')==profile and r.get('kind')=='sample'})\n  for metric in metrics:\n   samples={label:[r['elapsed_ms'] for r in records if r.get('profile')==profile and r.get('kind')=='sample' and r.get('metric')==metric and r['revision']==label] for label in ['base','candidate']}\n   medians={label:statistics.median(values) for label,values in samples.items()}\n   summary={'kind':'summary','profile':profile,'metric':metric,'median_ms':medians,'change_percent':100*(medians['candidate']/medians['base']-1),'samples':{label:len(v) for label,v in samples.items()},'p95_ms':{label:sorted(v)[__import__('math').ceil(0.95*len(v))-1]for label,v in samples.items()}}\n   output.write(json.dumps(summary)+'\\n');print(summary,flush=True)\n"}
