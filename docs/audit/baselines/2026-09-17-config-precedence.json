    "merge_extraction": "impl Cli {\n    // Behavior-preserving extraction for the configuration regression controls.\n    pub fn apply_config(&mut self, file_config: Config, _matches: &clap::ArgMatches) {\n        self.data_dir = file_config.data_dir.or(self.data_dir.take());\n        self.log_level = super::effective_log_filter(&self.log_level, file_config.log_level);\n        self.partition_target_rows = file_config\n            .partition_target_rows\n            .unwrap_or(self.partition_target_rows);\n        self.checkpoint = file_config.checkpoint.or(self.checkpoint.take());\n        self.checkpoint_sync_url = file_config\n            .checkpoint_sync_url\n            .or(self.checkpoint_sync_url.take());\n        if let Command::Sync {\n            http_host,\n            grpc_host,\n            nat,\n            p2p_bind_ip,\n            execution_bootnodes,\n            execution_discv5_port,\n            allow_public_grpc,\n            disable_dashboard,\n            dashboard_password,\n            ..\n        } = &mut self.command\n        {\n            if nat == \"any\" {\n                *nat = file_config.nat.unwrap_or_else(|| std::mem::take(nat));\n            }\n            *http_host = file_config.http_host.unwrap_or(*http_host);\n            *grpc_host = file_config.grpc_host.unwrap_or(*grpc_host);\n            *p2p_bind_ip = file_config.p2p_bind_ip.or(*p2p_bind_ip);\n            if execution_bootnodes.is_empty() {\n                *execution_bootnodes = file_config.execution_bootnodes.unwrap_or_default();\n            }\n            *execution_discv5_port = file_config\n                .execution_discv5_port\n                .unwrap_or(*execution_discv5_port);\n            *allow_public_grpc = file_config.allow_public_grpc.unwrap_or(*allow_public_grpc);\n            *disable_dashboard =\n                !(file_config.dashboard_enabled.unwrap_or(true) && !*disable_dashboard);\n            *dashboard_password = dashboard_password.take().or(file_config.dashboard_password);\n        }\n    }\n}\n"
  },
