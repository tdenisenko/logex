{"kind": "source", "candidate_worktree_diff": "diff --git a/crates/logex-storage/src/column.rs b/crates/logex-storage/src/column.rs\nindex 52797f01..fbda67de 100644\n--- a/crates/logex-storage/src/column.rs\n+++ b/crates/logex-storage/src/column.rs\n@@ -695,6 +695,7 @@ impl ColumnFile {\n     }\n \n     /// Write a canonical bitmap where all rows are marked canonical (all 1s).\n+    #[cfg(test)]\n     pub(crate) fn write_canonical_bitmap(dir: &Path, row_count: u64) -> io::Result<()> {\n         let mut bitmap = NullBitmap::new();\n         for _ in 0..row_count {\ndiff --git a/crates/logex-storage/src/native/segment.rs b/crates/logex-storage/src/native/segment.rs\nindex d61e5387..9e235a90 100644\n--- a/crates/logex-storage/src/native/segment.rs\n+++ b/crates/logex-storage/src/native/segment.rs\n@@ -72,7 +72,7 @@ impl<'a> PageOutput<'a> {\n             dir,\n             existing_rows: 0,\n             previous: Default::default(),\n-            canonical: None,\n+            canonical: Some(NullBitmap::new()),\n             replacements: None,\n         }\n     }\n@@ -306,9 +306,11 @@ pub(crate) fn write_compacted_rows(\n ) -> std::io::Result<Vec<ColumnDescriptor>> {\n     fs::create_dir_all(segment_dir)?;\n     fs::create_dir_all(segment_dir.join(\"columns\"))?;\n-    ColumnFile::write_canonical_bitmap(segment_dir, rows.len() as u64)?;\n-\n     let output = PageOutput::new(segment_dir);\n+    // This is a new representation with no committed rows. Publish its bitmap\n+    // together with its columns; the containing manifest/catalog supplies the\n+    // ordering and durable flush, just as it does for the new page payloads.\n+    output.append_canonical(rows.len())?;\n     let columns = write_compacted_values(&output, rows)?;\n     output.finish()?;\n     Ok(columns)\ndiff --git a/crates/logex-storage/src/native/storage.rs b/crates/logex-storage/src/native/storage.rs\nindex 81fa8350..62d35103 100644\n--- a/crates/logex-storage/src/native/storage.rs\n+++ b/crates/logex-storage/src/native/storage.rs\n@@ -1388,15 +1388,12 @@ impl NativeStorage {\n             fs::remove_dir_all(&segment_dir)?;\n         }\n         fs::create_dir_all(&segment_dir)?;\n-        persist_ingest_manifest(\n-            &self.paths,\n-            &descriptor,\n-            self.segment_publication(descriptor.id),\n-        )?;\n+        // The caller immediately writes the first nonempty chunk and publishes\n+        // its complete manifest. This allocation is still outside the durable\n+        // catalog, so an empty intermediate manifest adds no recovery evidence.\n         let segment_id = descriptor.id;\n         self.catalog.segments.push(descriptor);\n         self.catalog.active_historical_segment = Some(segment_id);\n-        self.persist_catalog()?;\n         Ok(segment_id)\n     }\n \n", "lockfile_sha256": "14c92b32a2b205d1a2dc56deb08d297c7383847d43ef7528f2dd54e169d4d411", "fixture_sha256": "9ebbbacd0a18a1b12c5bd63353c7044609c6d930f9ec096fc7860754de92aff2", "base_fixture_sha256": "9ebbbacd0a18a1b12c5bd63353c7044609c6d930f9ec096fc7860754de92aff2"}
