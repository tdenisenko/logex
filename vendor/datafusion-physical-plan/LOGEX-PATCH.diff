+    #[tokio::test(flavor = "current_thread")]
+    async fn logex_internal_sort_stream_retains_runtime_until_drop() -> Result<()> {
+        let schema = Arc::new(Schema::new(vec![Field::new("i", DataType::Int32, false)]));
+        let ordering = [PhysicalSortExpr {
+            expr: col("i", &schema)?,
+            options: SortOptions::default(),
+        }]
+        .into();
+        let metrics = ExecutionPlanMetricsSet::new();
+        let runtime = RuntimeEnvBuilder::new()
+            .with_disk_manager_builder(
+                DiskManagerBuilder::default().with_mode(DiskManagerMode::Disabled),
+            )
+            .build_arc()?;
+        let weak_runtime = Arc::downgrade(&runtime);
+        let config = SessionConfig::new();
+        let mut sorter = ExternalSorter::new(
+            0,
+            Arc::clone(&schema),
+            ordering,
+            1,
+            config.options().execution.sort_spill_reservation_bytes,
+            0,
+            config.spill_compression(),
+            &metrics,
+            Arc::clone(&runtime),
+        )?;
+        for values in [[2, 1], [4, 3]] {
+            sorter
+                .insert_batch(RecordBatch::try_new(
+                    Arc::clone(&schema),
+                    vec![Arc::new(Int32Array::from(values.to_vec()))],
+                )?)
+                .await?;
+        }
+
+        let mut stream = sorter.sort().await?;
+        drop(sorter);
+        drop(runtime);
+
+        assert!(
+            weak_runtime.upgrade().is_some(),
+            "internal multi-batch sort streams must retain their query runtime"
+        );
+        let first_batch = stream
+            .next()
+            .await
+            .transpose()?
+            .expect("multi-batch sort must produce output");
+        assert_eq!(first_batch.num_rows(), 1);
+        assert!(
+            weak_runtime.upgrade().is_some(),
+            "runtime ownership must survive the internal sort future's first yield"
+        );
+        drop(stream);
+        assert!(
+            weak_runtime.upgrade().is_none(),
+            "the query runtime must release when the internal sort stream releases"
+        );
         Ok(())
     }
 
