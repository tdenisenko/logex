+    fn checked_sum(&self, array: &ArrayRef, initial: i64, retract: bool) -> Result<i64> {
+        if array.null_count() == array.len() {
+            return Ok(initial);
+        }
+        let values = match self.time_unit {
+            TimeUnit::Second => array.as_primitive::<DurationSecondType>().values(),
