+            TimeUnit::Nanosecond => {
+                array.as_primitive::<DurationNanosecondType>().values()
+            }
+        };
+        let nulls = array.nulls();
+        let values = values
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| nulls.is_none_or(|nulls| nulls.is_valid(*index)));
+        let mut sum = initial;
