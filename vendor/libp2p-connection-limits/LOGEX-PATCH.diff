+#[cfg(test)]
+mod logex_retention_tests {
+    use super::*;
+
+    fn peer(value: u8) -> PeerId {
+        let mut bytes = [value; 34];
+        bytes[0] = 0x12;
+        bytes[1] = 32;
+        PeerId::from_bytes(&bytes).unwrap()
+    }
+
+    fn endpoint(inbound: bool) -> ConnectedPoint {
+        let address = "/memory/1234".parse::<Multiaddr>().unwrap();
+        if inbound {
+            ConnectedPoint::Listener {
+                local_addr: address.clone(),
+                send_back_addr: address,
+            }
+        } else {
+            ConnectedPoint::Dialer {
+                address,
+                role_override: Endpoint::Dialer,
+                port_use: PortUse::Reuse,
+            }
+        }
+    }
+
+    // Follow admission before reporting successful establishment. A sibling can
+    // still reject after admission, so this helper deliberately sends no event.
+    fn admit(
+        behaviour: &mut Behaviour,
+        peer_id: PeerId,
+        connection_id: ConnectionId,
+        endpoint: &ConnectedPoint,
+    ) -> Result<dummy::ConnectionHandler, ConnectionDenied> {
+        match endpoint {
+            ConnectedPoint::Listener {
+                local_addr,
+                send_back_addr,
+            } => {
+                behaviour.handle_pending_inbound_connection(
+                    connection_id,
+                    local_addr,
+                    send_back_addr,
+                )?;
+                behaviour.handle_established_inbound_connection(
+                    connection_id,
+                    peer_id,
+                    local_addr,
+                    send_back_addr,
+                )
+            }
+            ConnectedPoint::Dialer {
+                address,
+                role_override,
+                port_use,
+            } => {
+                behaviour.handle_pending_outbound_connection(
+                    connection_id,
+                    Some(peer_id),
+                    std::slice::from_ref(address),
+                    *role_override,
+                )?;
+                behaviour.handle_established_outbound_connection(
+                    connection_id,
+                    peer_id,
+                    address,
+                    *role_override,
+                    *port_use,
+                )
+            }
+        }
+    }
+
+    fn establish(
+        behaviour: &mut Behaviour,
+        peer_id: PeerId,
+        connection_id: ConnectionId,
+        endpoint: &ConnectedPoint,
+    ) {
+        admit(behaviour, peer_id, connection_id, endpoint).unwrap();
+        let other_established = behaviour
+            .established_per_peer
+            .get(&peer_id)
+            .map_or(0, HashSet::len);
+        behaviour.on_swarm_event(FromSwarm::ConnectionEstablished(ConnectionEstablished {
+            peer_id,
+            connection_id,
+            endpoint,
+            failed_addresses: &[],
+            other_established,
+        }));
+        assert!(behaviour.pending_inbound_connections.is_empty());
+        assert!(behaviour.pending_outbound_connections.is_empty());
+    }
+
+    fn close(
+        behaviour: &mut Behaviour,
+        peer_id: PeerId,
+        connection_id: ConnectionId,
+        endpoint: &ConnectedPoint,
+        remaining_established: usize,
+    ) {
+        // Every close in these tests has an earlier successful establishment.
+        assert!(behaviour.established_per_peer[&peer_id].contains(&connection_id));
+        behaviour.on_swarm_event(FromSwarm::ConnectionClosed(ConnectionClosed {
+            peer_id,
+            connection_id,
+            endpoint,
+            cause: None,
+            remaining_established,
+        }));
+    }
+
+    #[test]
+    fn logex_final_close_releases_peer_records_across_finite_churn() {
+        let mut behaviour =
+            Behaviour::new(ConnectionLimits::default().with_max_established_per_peer(Some(1)));
+        for value in 1..=4 {
+            let remote = peer(value);
+            let connection = ConnectionId::new_unchecked(usize::from(value));
+            let endpoint = endpoint(value % 2 == 0);
+            establish(&mut behaviour, remote, connection, &endpoint);
+            assert_eq!(behaviour.established_per_peer.len(), 1);
+            close(&mut behaviour, remote, connection, &endpoint, 0);
+            // Both direction counters already clear on the original source;
+            // this regression fails only because its empty peer key remains.
+            assert!(behaviour.established_inbound_connections.is_empty());
+            assert!(behaviour.established_outbound_connections.is_empty());
+            assert_eq!(
+                behaviour.established_per_peer.len(),
+                0,
+                "final close retained a peer record"
+            );
+        }
+    }
+
+    #[test]
+    fn logex_partial_close_keeps_live_ids_limits_and_unrelated_peers() {
+        let mut behaviour = Behaviour::new(
+            ConnectionLimits::default()
+                .with_max_established_per_peer(Some(2))
+                .with_max_established(Some(3)),
+        );
+        let remote = peer(1);
+        let unrelated = peer(2);
+        let incoming = endpoint(true);
+        let outgoing = endpoint(false);
+        let first = ConnectionId::new_unchecked(1);
+        let second = ConnectionId::new_unchecked(2);
+        let other = ConnectionId::new_unchecked(3);
+        establish(&mut behaviour, remote, first, &incoming);
+        establish(&mut behaviour, remote, second, &outgoing);
+        establish(&mut behaviour, unrelated, other, &outgoing);
+        // Tightening a configured limit does not evict existing connections.
+        // While any connection remains, that one-slot limit still applies.
+        behaviour.limits_mut().max_established_per_peer = Some(1);
+        close(&mut behaviour, remote, first, &incoming, 1);
+        assert_eq!(
+            behaviour.established_per_peer[&remote],
+            HashSet::from([second])
+        );
+        assert_eq!(
+            behaviour.established_per_peer[&unrelated],
+            HashSet::from([other])
+        );
+        assert!(behaviour.established_inbound_connections.is_empty());
+        assert_eq!(
+            behaviour.established_outbound_connections,
+            HashSet::from([second, other])
+        );
+        let denied_id = ConnectionId::new_unchecked(4);
+        let denied = admit(&mut behaviour, remote, denied_id, &outgoing)
+            .err()
+            .expect("remaining connection must enforce the per-peer limit");
+        let exceeded = denied.downcast_ref::<Exceeded>().unwrap();
+        assert_eq!(exceeded.limit(), 1);
+        assert!(matches!(exceeded.kind, Kind::EstablishedPerPeer));
+        let error = libp2p_swarm::DialError::Denied { cause: denied };
+        behaviour.on_swarm_event(FromSwarm::DialFailure(DialFailure {
+            peer_id: Some(remote),
+            connection_id: denied_id,
+            error: &error,
+        }));
+        assert!(behaviour.pending_outbound_connections.is_empty());
+        close(&mut behaviour, remote, second, &outgoing, 0);
+        assert!(!behaviour.established_per_peer.contains_key(&remote));
+        assert_eq!(behaviour.established_per_peer.len(), 1);
+        assert_eq!(
+            behaviour.established_outbound_connections,
+            HashSet::from([other])
+        );
+        assert_eq!(
+            behaviour.established_per_peer[&unrelated],
+            HashSet::from([other])
+        );
+        let reconnected = ConnectionId::new_unchecked(5);
+        establish(&mut behaviour, remote, reconnected, &incoming);
+        assert_eq!(
+            behaviour.established_per_peer[&remote],
+            HashSet::from([reconnected])
+        );
+        close(&mut behaviour, remote, reconnected, &incoming, 0);
+        close(&mut behaviour, unrelated, other, &outgoing, 0);
+        assert!(behaviour.established_per_peer.is_empty());
+        assert!(behaviour.established_inbound_connections.is_empty());
+        assert!(behaviour.established_outbound_connections.is_empty());
+    }
+
+    #[test]
+    fn logex_sibling_denial_after_admission_creates_no_established_peer_record() {
+        for inbound in [false, true] {
+            let mut behaviour = Behaviour::new(
+                ConnectionLimits::default()
+                    .with_max_pending_incoming(Some(1))
+                    .with_max_pending_outgoing(Some(1))
+                    .with_max_established_per_peer(Some(1)),
+            );
+            let remote = peer(1);
+            let endpoint = endpoint(inbound);
+            let connection = ConnectionId::new_unchecked(1);
+            admit(&mut behaviour, remote, connection, &endpoint).unwrap();
+            assert!(behaviour.pending_inbound_connections.is_empty());
+            assert!(behaviour.pending_outbound_connections.is_empty());
+            // A sibling denies this attempt before ConnectionEstablished. Swarm
+            // reports failure, not ConnectionClosed, to the admitted behaviour.
+            let cause = ConnectionDenied::new(std::io::Error::other("sibling denial"));
+            match &endpoint {
+                ConnectedPoint::Listener {
+                    local_addr,
+                    send_back_addr,
+                } => {
+                    let error = libp2p_swarm::ListenError::Denied { cause };
+                    behaviour.on_swarm_event(FromSwarm::ListenFailure(ListenFailure {
+                        local_addr,
+                        send_back_addr,
+                        peer_id: Some(remote),
+                        connection_id: connection,
+                        error: &error,
+                    }));
+                }
+                ConnectedPoint::Dialer { .. } => {
+                    let error = libp2p_swarm::DialError::Denied { cause };
+                    behaviour.on_swarm_event(FromSwarm::DialFailure(DialFailure {
+                        peer_id: Some(remote),
+                        connection_id: connection,
+                        error: &error,
+                    }));
+                }
+            }
+            assert!(behaviour.established_per_peer.is_empty());
+            assert!(behaviour.established_inbound_connections.is_empty());
+            assert!(behaviour.established_outbound_connections.is_empty());
+            // The failed attempt has not consumed admission capacity.
+            establish(
+                &mut behaviour,
+                remote,
+                ConnectionId::new_unchecked(2),
+                &endpoint,
+            );
+            close(
+                &mut behaviour,
+                remote,
+                ConnectionId::new_unchecked(2),
+                &endpoint,
+                0,
+            );
+            assert!(behaviour.established_inbound_connections.is_empty());
+            assert!(behaviour.established_outbound_connections.is_empty());
+        }
+    }
+}
