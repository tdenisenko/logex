+// Modified by LogEx on 2026-09-13: backport Apache DataFusion PR #24258,
+// tightened to apply set algebra only where structural equality proves runtime equality.
+/// Set algebra on `IN` lists is only sound for total, repeatable operands with
+/// one normalized type whose structural equality agrees with SQL equality.
+/// Preserve the original expression for nullable, nested, annotated, coerced,
+/// or runtime list values.
+fn can_simplify_inlist_set_operation<S: SimplifyInfo>(
+    info: &S,
+    left: &InList,
+    right: &InList,
+) -> Result<bool> {
+    if !is_safe_inlist_tested_expr(left.expr.as_ref())
+        || !is_safe_inlist_tested_expr(right.expr.as_ref())
+        || !left
+            .list
+            .iter()
+            .chain(&right.list)
+            .all(is_safe_inlist_set_literal)
+    {
+        return Ok(false);
+    }
+
+    let common_type = info.get_data_type(left.expr.as_ref())?;
+    if info.get_data_type(right.expr.as_ref())? != common_type {
+        return Ok(false);
+    }
+    for item in left.list.iter().chain(&right.list) {
+        if info.get_data_type(item)? != common_type {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
