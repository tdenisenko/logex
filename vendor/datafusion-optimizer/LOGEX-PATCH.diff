+fn preserve_inlist_null_result<S: SimplifyInfo>(
+    info: &S,
+    tested_expr: Expr,
+    result: Expr,
+) -> Result<Expr> {
+    if !is_true(&result) && !is_false(&result) {
+        return Ok(result);
+    }
+
+    Ok(if !info.nullable(&tested_expr)? {
+        result
+    } else if is_true(&result) {
+        Expr::IsNotNull(Box::new(tested_expr)).or(lit_bool_null())
+    } else {
+        Expr::IsNull(Box::new(tested_expr)).and(lit_bool_null())
+    })
+}
