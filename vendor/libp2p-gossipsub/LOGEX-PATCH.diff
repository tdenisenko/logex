+fn logex_cache_test_config(limits: crate::CacheLimits) -> Config {
+    ConfigBuilder::default()
+        .cache_limits(limits)
+        .message_id_fn(|message| MessageId::new(&message.data))
+        .idontwant_message_size_threshold(0)
+        .build()
+        .unwrap()
+}
