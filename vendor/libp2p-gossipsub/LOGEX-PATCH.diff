+#[test]
+fn logex_expiry_ihave_requests_expired_but_not_live_id() {
+    let (mut gs, peers, mut receivers, topics) = inject_nodes1()
+        .peer_no(1)
+        .topics(vec![String::from("topic1")])
+        .to_subscribe(true)
+        .create_network();
+    let now = Instant::now();
+    let expired = MessageId::new(&[1; 20]);
+    let live = MessageId::new(&[2; 20]);
+    gs.duplicate_cache.insert_at(
+        expired.clone(),
+        now - gs.config.duplicate_cache_time() - Duration::from_secs(1),
+    );
+    // The second insertion precedes the first deadline; ordering stays chronological.
+    gs.duplicate_cache
+        .insert_at(live.clone(), now - Duration::from_secs(2));
+    gs.handle_ihave(
+        &peers[0],
+        vec![(topics[0].clone(), vec![expired.clone(), live])],
+    );
+    let receiver = receivers.remove(&peers[0]).unwrap();
+    let queue = receiver.non_priority.get_ref();
+    let mut requested = Vec::new();
+    while let Ok(rpc) = queue.try_recv() {
+        if let RpcOut::IWant(IWant { message_ids }) = rpc {
+            requested.extend(message_ids);
+        }
+    }
+    assert_eq!(requested, vec![expired]);
+}
+
+#[test]
+fn logex_expiry_heartbeat_releases_idle_duplicate_owners() {
+    let (mut gs, _, _, _) = inject_nodes1().create_network();
+    let now = Instant::now();
+    let expired = MessageId::new(&[1; 20]);
+    gs.duplicate_cache.insert_at(
+        expired.clone(),
+        now - gs.config.duplicate_cache_time() - Duration::from_secs(1),
+    );
+    gs.published_message_ids.insert_at(
+        expired,
+        now - gs.config.published_message_ids_cache_time() - Duration::from_secs(1),
+    );
+    assert_eq!(gs.duplicate_cache.retained_len(), 1);
+    assert_eq!(gs.published_message_ids.retained_len(), 1);
+    gs.heartbeat();
+    assert_eq!(gs.duplicate_cache.retained_len(), 0);
+    assert_eq!(gs.published_message_ids.retained_len(), 0);
+    let live = MessageId::new(&[2; 20]);
+    gs.duplicate_cache.insert(live.clone());
+    gs.published_message_ids.insert(live.clone());
+    gs.heartbeat();
+    assert!(gs.duplicate_cache.contains(&live));
+    assert!(gs.published_message_ids.contains(&live));
+}
