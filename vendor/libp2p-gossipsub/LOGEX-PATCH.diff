+fn logex_topic_message(source: PeerId, topic: &str, data: u8) -> RawMessage {
+    RawMessage {
+        source: Some(source),
+        data: vec![data],
+        sequence_number: Some(u64::from(data)),
+        topic: Topic::new(topic).hash(),
+        signature: None,
+        key: None,
+        validated: false,
+    }
+}
