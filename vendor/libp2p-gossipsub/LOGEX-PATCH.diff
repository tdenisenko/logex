+            let connection = ConnectionId::new_unchecked(0);
+            let address = "/ip4/127.0.0.1/tcp/1234".parse::<Multiaddr>().unwrap();
+            let _handler = if outbound {
+                gs.handle_established_outbound_connection(
+                    connection,
+                    peer,
+                    &address,
