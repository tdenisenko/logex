+#[test]
+fn logex_expiry_ihave_requests_expired_but_not_live_id() {
+    let (mut gs, peers, mut receivers, topics) = inject_nodes1()
+        .peer_no(1)
+        .topics(vec![String::from("topic1")])
+        .to_subscribe(true)
+        .create_network();
+    let now = Instant::now();
+    let expired = MessageId::new(&[1; 20]);
+    let live = MessageId::new(&[2; 20]);
+    gs.duplicate_cache.insert_at(
+        expired.clone(),
+        now - gs.config.duplicate_cache_time() - Duration::from_secs(1),
+    );
+    // The second insertion precedes the first deadline; ordering stays chronological.
+    gs.duplicate_cache
+        .insert_at(live.clone(), now - Duration::from_secs(2));
+    gs.handle_ihave(
+        &peers[0],
+        vec![(topics[0].clone(), vec![expired.clone(), live])],
+    );
+    let mut receiver = receivers.remove(&peers[0]).unwrap();
+    let mut requested = Vec::new();
+    for rpc in receiver.drain_non_priority() {
+        if let RpcOut::IWant(IWant { message_ids }) = rpc {
+            requested.extend(message_ids);
+        }
+    }
+    assert_eq!(requested, vec![expired]);
+}
