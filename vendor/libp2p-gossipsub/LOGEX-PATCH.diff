+#[test]
+fn logex_expiry_heartbeat_releases_idle_duplicate_owners() {
+    let (mut gs, _, _, _) = inject_nodes1().create_network();
+    let now = Instant::now();
+    let expired = MessageId::new(&[1; 20]);
+    gs.duplicate_cache.insert_at(
+        expired.clone(),
+        now - gs.config.duplicate_cache_time() - Duration::from_secs(1),
+    );
+    gs.published_message_ids.insert_at(
+        expired,
+        now - gs.config.published_message_ids_cache_time() - Duration::from_secs(1),
+    );
+    assert_eq!(gs.duplicate_cache.retained_len(), 1);
+    assert_eq!(gs.published_message_ids.retained_len(), 1);
+    gs.heartbeat();
+    assert_eq!(gs.duplicate_cache.retained_len(), 0);
+    assert_eq!(gs.published_message_ids.retained_len(), 0);
+    let live = MessageId::new(&[2; 20]);
+    gs.duplicate_cache.insert(live.clone());
+    gs.published_message_ids.insert(live.clone());
+    gs.heartbeat();
+    assert!(gs.duplicate_cache.contains(&live));
+    assert!(gs.published_message_ids.contains(&live));
+}
