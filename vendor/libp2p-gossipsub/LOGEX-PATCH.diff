+    for limit in 0..4 {
+        let mut limits = crate::CacheLimits::default();
+        match limit {
+            0 => limits.seen_entries = 1,
+            1 => limits.seen_bytes = 2,
+            2 => limits.message_entries = 1,
+            _ => limits.message_bytes = 5,
+        }
+        let (mut gs, peers, mut receivers, topics) = inject_nodes1()
